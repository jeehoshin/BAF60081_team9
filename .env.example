# ==========================================
# 같이 갈래? (gachi-galae) 환경 변수 설정
# ==========================================

# 1. Supabase PostgreSQL 연결 URI (Transaction Pooler: 포트 6543 권장)
# 예: postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# 2. CORS 허용 Origin 목록 (쉼표 구분)
# 로컬 개발 및 Vercel 배포 URL
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# 3. DB 메모리 모드 플래그
# 0 = Supabase DB 사용 (배포/팀 공유 시 필수)
# 1 = 로컬 단독 시연용 인메모리 SQLite
USE_MEMORY=0

# 4. 공공 API 키 (수집: Render의 POST /collect 또는 scripts/collect_activities.py)
#    TOUR_API_KEY는 공공데이터포털 '일반 인증키 (Decoding)' 값
TOUR_API_KEY=
KOPIS_API_KEY=
# 한국문화정보원 전시. 공공데이터포털 키라서 TOUR_API_KEY와 같은 값이어도 된다
# (공공데이터포털에서 '한국문화정보원_한눈에보는문화정보조회서비스' 활용신청 필요)
CULTURE_API_KEY=

# 5. Swagger에서 POST /collect를 실행할 때 x-collect-token에 넣는 값 (비우면 /collect 막힘)
COLLECT_TOKEN=
